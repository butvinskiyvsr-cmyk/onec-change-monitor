<Window x:Class="OneCChangeMonitor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneC Change Monitor" Width="1480" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="26" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="212" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="1C" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Change Monitor" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="TitleProjectText" Text=" / проект не выбран" Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse x:Name="SyncDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
                    <TextBlock x:Name="SyncLabel" Text="Локальная копия" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <Button x:Name="UpdateAvailableButton" Grid.Column="4" Style="{StaticResource SecondaryButton}" Height="29" Visibility="Collapsed"
                        Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}" BorderBrush="Transparent"
                        Content="Доступно обновление" Click="UpdateAvailableButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="12,15,12,13">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Padding="8,4,8,14" BorderBrush="#29405E" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="АКТИВНЫЙ ПРОЕКТ" Foreground="#8198B4" FontSize="10" FontWeight="SemiBold" />
                        <ComboBox x:Name="ProjectCombo" Style="{StaticResource InputComboBox}" Margin="0,8,0,0" DisplayMemberPath="Name"
                                  SelectionChanged="ProjectCombo_SelectionChanged" Background="#1B304C" Foreground="White" BorderBrush="#35506F" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,11,0,0">
                    <RadioButton x:Name="OverviewNav" GroupName="Navigation" Tag="Overview" Style="{StaticResource NavigationButton}" Click="Navigation_Click"><TextBlock Text="⌂   Обзор" /></RadioButton>
                    <RadioButton x:Name="ChangesNav" GroupName="Navigation" Tag="Changes" IsChecked="True" Style="{StaticResource NavigationButton}" Click="Navigation_Click"><Grid><TextBlock Text="⑂   Изменения" /><Border HorizontalAlignment="Right" Background="#315A84" CornerRadius="8" Padding="6,1"><TextBlock x:Name="CommitCountBadge" Text="0" Foreground="#C8D9EC" FontSize="10" /></Border></Grid></RadioButton>
                    <RadioButton x:Name="ObjectsNav" GroupName="Navigation" Tag="Objects" Style="{StaticResource NavigationButton}" Click="Navigation_Click"><TextBlock Text="▦   Объекты 1С" /></RadioButton>
                    <RadioButton x:Name="ReleasesNav" GroupName="Navigation" Tag="Releases" Style="{StaticResource NavigationButton}" Click="Navigation_Click"><TextBlock Text="◇   Релизы" /></RadioButton>
                    <RadioButton x:Name="QualityNav" GroupName="Navigation" Tag="Quality" Style="{StaticResource NavigationButton}" Click="Navigation_Click"><Grid><TextBlock Text="✓   Качество" /><Border x:Name="QualityBadge" Visibility="Collapsed" HorizontalAlignment="Right" Background="#765521" CornerRadius="8" Padding="6,1"><TextBlock x:Name="QualityCountBadge" Foreground="#FFE4AA" FontSize="10" /></Border></Grid></RadioButton>
                    <TextBlock Text="СИСТЕМА" Foreground="#8198B4" FontSize="10" FontWeight="SemiBold" Margin="10,18,0,6" />
                    <RadioButton x:Name="ProjectsNav" GroupName="Navigation" Tag="Projects" Style="{StaticResource NavigationButton}" Click="Navigation_Click"><TextBlock Text="▣   Проекты" /></RadioButton>
                    <RadioButton x:Name="UpdatesNav" GroupName="Navigation" Tag="Updates" Style="{StaticResource NavigationButton}" Click="Navigation_Click"><TextBlock Text="↓   Обновления" /></RadioButton>
                    <RadioButton x:Name="SettingsNav" GroupName="Navigation" Tag="Settings" Style="{StaticResource NavigationButton}" Click="Navigation_Click"><TextBlock Text="⚙   Настройки" /></RadioButton>
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="#29405E" BorderThickness="0,1,0,0" Padding="8,13,8,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="29" Height="29" CornerRadius="8" Background="#294867"><TextBlock Text="ВБ" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Локальный профиль" Foreground="#DCE7F4" FontSize="11" /><TextBlock Text="Версия 0.2.0" Foreground="#8198B4" FontSize="10" Margin="0,2,0,0" /></StackPanel></Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid x:Name="ChangesPage">
                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /><ColumnDefinition Width="145" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Изменения конфигурации" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><TextBlock Text="История Git, сгруппированная по объектам 1С" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" /></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource InputTextBox}" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по сообщению, автору или хэшу" /><ComboBox x:Name="BranchCombo" Grid.Column="2" Margin="9,0,0,0" Style="{StaticResource InputComboBox}" VerticalAlignment="Center" SelectionChanged="BranchCombo_SelectionChanged" /><Button x:Name="SyncButton" Grid.Column="3" Margin="9,0,0,0" Style="{StaticResource PrimaryButton}" Content="Синхронизировать" Click="SyncButton_Click" VerticalAlignment="Center" /></Grid>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="305" /><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0"><Grid><TextBlock Text="ЛЕНТА ИЗМЕНЕНИЙ" Style="{StaticResource PaneHeader}" /><TextBlock x:Name="HistoryCaption" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" /></Grid></Border><ListBox x:Name="CommitList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="CommitList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,11" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="BorderBrush" Value="#E8EDF3" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Background" Value="White" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="#BDD5F6" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F7FB" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ShortSha}" Foreground="{StaticResource AccentBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding RelativeTime}" Foreground="{StaticResource MutedBrush}" FontSize="10" /></Grid><TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" Margin="0,6,0,7" /><TextBlock Text="{Binding Author}" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="13,0"><Grid><TextBlock Text="ОБЪЕКТЫ И ФАЙЛЫ" Style="{StaticResource PaneHeader}" /><TextBlock x:Name="FileCountText" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" /></Grid></Border><StackPanel Grid.Row="1" Margin="13,12,13,10"><TextBlock x:Name="CommitTitle" Text="Выберите коммит" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="CommitMeta" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel><Border x:Name="WarningPanel" Grid.Row="2" Visibility="Collapsed" Margin="10,0,10,9" Padding="9" CornerRadius="7" Background="#FFF3DA"><TextBlock x:Name="WarningText" Foreground="#855100" FontSize="11" TextWrapping="Wrap" /></Border><ListBox x:Name="FileList" Grid.Row="3" BorderThickness="0" Background="Transparent" SelectionChanged="FileList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="11,9" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="BorderBrush" Value="#E8EDF3" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F7FB" /></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="29" /><ColumnDefinition Width="*" /><ColumnDefinition Width="25" /></Grid.ColumnDefinitions><Border Width="23" Height="23" CornerRadius="6" Background="#EEF2F7"><TextBlock Text="{Binding KindGlyph}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="7,0,4,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" /></StackPanel><Border Grid.Column="2" Width="20" Height="20" CornerRadius="6" Background="#FFF3DA"><TextBlock Text="{Binding Status}" Foreground="{StaticResource WarningBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                    </Border>
                    <Grid Grid.Column="2" Background="#FBFCFE">
                        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="DiffObjectTitle" Text="Сравнение изменений" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="DiffPath" Text="Выберите файл слева" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" Content="↑" ToolTip="Предыдущее изменение" /><Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Content="↓" ToolTip="Следующее изменение" /></StackPanel></Grid></Border>
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" Margin="14,0"><Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2"><TextBlock Text="КОД" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11" Padding="1,11,1,9" /></Border><TextBlock Text="XML" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="22,0,0,0" VerticalAlignment="Center" /><TextBlock Text="ИСТОРИЯ ОБЪЕКТА" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="22,0,0,0" VerticalAlignment="Center" /></StackPanel></Border>
                        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Background="#F0F3F7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="ДО ИЗМЕНЕНИЯ" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="48,0,0,0" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="ПОСЛЕ ИЗМЕНЕНИЯ" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="48,0,0,0" VerticalAlignment="Center" /></Grid><ListView x:Name="DiffList" Grid.Row="1" BorderThickness="0" Background="#FBFCFE" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="BorderThickness" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Grid MinWidth="720"><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{Binding OldBackground}" Padding="0,2"><TextBlock Text="{Binding OldNumber}" Foreground="#8B97A8" FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalAlignment="Right" Margin="0,0,7,0" /></Border><Border Grid.Column="1" Background="{Binding OldBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="7,2"><TextBlock Text="{Binding OldText}" Foreground="{Binding OldForeground}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap" /></Border><Border Grid.Column="2" Background="{Binding NewBackground}" Padding="0,2"><TextBlock Text="{Binding NewNumber}" Foreground="#8B97A8" FontFamily="Cascadia Mono, Consolas" FontSize="11" HorizontalAlignment="Right" Margin="0,0,7,0" /></Border><Border Grid.Column="3" Background="{Binding NewBackground}" Padding="7,2"><TextBlock Text="{Binding NewText}" Foreground="{Binding NewForeground}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap" /></Border></Grid></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="EmptyDiffPanel" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="&lt;/&gt;" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold" /></Border><TextBlock Text="Выберите файл, чтобы увидеть изменения" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" /></StackPanel></Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="OverviewPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Обзор проекта" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Состояние конфигурации и последние события" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Border><ScrollViewer Grid.Row="1"><StackPanel Margin="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Border Style="{StaticResource CardBorder}" Padding="17" Margin="0,0,10,0"><StackPanel><TextBlock Text="КОММИТОВ ЗАГРУЖЕНО" Style="{StaticResource PaneHeader}" /><TextBlock x:Name="OverviewCommitCount" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,1" /><TextBlock Text="по выбранной ветке" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="17" Margin="5,0"><StackPanel><TextBlock Text="ОБЪЕКТОВ В КОММИТЕ" Style="{StaticResource PaneHeader}" /><TextBlock x:Name="OverviewObjectCount" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,1" /><TextBlock Text="распознано по структуре 1С" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="17" Margin="10,0,0,0"><StackPanel><TextBlock Text="ТРЕБУЮТ ВНИМАНИЯ" Style="{StaticResource PaneHeader}" /><TextBlock x:Name="OverviewWarningCount" Text="0" Foreground="{StaticResource WarningBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,1" /><TextBlock Text="по текущему анализу" Foreground="{StaticResource MutedBrush}" FontSize="11" /></StackPanel></Border></Grid><TextBlock Text="АКТИВНЫЙ ПРОЕКТ" Style="{StaticResource PaneHeader}" Margin="0,24,0,9" /><Border Style="{StaticResource CardBorder}" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="Git" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="OverviewProjectName" FontWeight="SemiBold" /><TextBlock x:Name="OverviewProjectPath" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Открыть изменения" Click="OpenChanges_Click" VerticalAlignment="Center" /></Grid></Border></StackPanel></ScrollViewer></Grid>

            <Grid x:Name="ObjectsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Объекты 1С" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Объекты, затронутые выбранным изменением" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Border><ListBox x:Name="ObjectList" Grid.Row="1" Margin="22" BorderThickness="0" Background="Transparent"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,0,9" /><Setter Property="Padding" Value="15" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="1C" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>

            <Grid x:Name="QualityPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Качество изменений" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Автоматические проверки выбранного коммита" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Border><Grid Grid.Row="1" Margin="22"><ListBox x:Name="QualityList" BorderThickness="0" Background="Transparent"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,0,9" /><Setter Property="Padding" Value="15" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="26" Height="26" CornerRadius="7" Background="#FFF3DA"><TextBlock Text="!" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Severity}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" FontSize="11" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="QualityEmptyText" Text="По выбранному коммиту замечаний не обнаружено" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></Grid>

            <Grid x:Name="ReleasesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Релизы конфигурации" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Подготовка состава поставки между ветками и тегами" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="22" Padding="22" VerticalAlignment="Top"><StackPanel><TextBlock Text="Модуль запланирован следующим" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Здесь появятся сравнение тегов, группировка изменений по объектам 1С и автоматический список изменений для выпуска." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="680" HorizontalAlignment="Left" /></StackPanel></Border></Grid>

            <Grid x:Name="ProjectsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Проекты" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Несколько конфигураций и Git-источников в одном приложении" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Content="Добавить проект" Click="AddProject_Click" /></Grid></Border><ListBox x:Name="ProjectList" Grid.Row="1" Margin="22" BorderThickness="0" Background="Transparent"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Padding" Value="17" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="Git" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding LocalPath}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" /><TextBlock Text="{Binding RemoteUrl}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel><Border Grid.Column="2" Background="#E7F6EF" CornerRadius="8" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="Подключён" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" /></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>

            <Grid x:Name="UpdatesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Обновления" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Проверка новых версий через GitHub Releases" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="10,5"><TextBlock Text="СТАБИЛЬНЫЙ КАНАЛ" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" /></Border></Grid></Border><Grid Grid.Row="1" Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><Border Style="{StaticResource CardBorder}" Padding="22"><StackPanel><Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="9,4" HorizontalAlignment="Left"><TextBlock x:Name="LatestVersionText" Text="Версия не проверена" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" /></Border><TextBlock x:Name="UpdateTitleText" Text="OneC Change Monitor" FontSize="21" FontWeight="SemiBold" Margin="0,17,0,0" /><TextBlock x:Name="UpdateDescriptionText" Text="Проверьте наличие новой версии приложения." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="620" HorizontalAlignment="Left" /><TextBlock x:Name="ReleaseNotesText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0" MaxHeight="190" /><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="CheckUpdatesButton" Style="{StaticResource PrimaryButton}" Content="Проверить обновления" Click="CheckUpdatesButton_Click" /><Button x:Name="OpenReleaseButton" Style="{StaticResource SecondaryButton}" Content="Открыть страницу версии" Margin="8,0,0,0" IsEnabled="False" Click="OpenReleaseButton_Click" /></StackPanel></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18"><StackPanel><TextBlock Text="ПАРАМЕТРЫ" Style="{StaticResource PaneHeader}" /><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Проверять при запуске" /><TextBlock Text="Без загрузки и установки" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel><CheckBox x:Name="CheckUpdatesAtStartupBox" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Click="UpdatePreference_Click" /></Grid><Separator Margin="0,15" Background="{StaticResource BorderBrush}" /><TextBlock Text="Текущая версия" Foreground="{StaticResource MutedBrush}" FontSize="10" /><TextBlock Text="0.2.0" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="Автоматическая замена файлов будет включена только для подписанных пакетов с контрольной суммой. До этого установка выполняется с подтверждением." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,18,0,0" /></StackPanel></Border></Grid></Grid>

            <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Интерфейс, Git и диагностика" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="22" Padding="20" VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left"><StackPanel Width="680"><TextBlock Text="ИНТЕРФЕЙС" Style="{StaticResource PaneHeader}" /><Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Тема" /><TextBlock Text="Системная тема Windows" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel><ComboBox Grid.Column="1" Style="{StaticResource InputComboBox}" SelectedIndex="0"><ComboBoxItem>Светлая</ComboBoxItem></ComboBox></Grid><Separator Margin="0,16" Background="{StaticResource BorderBrush}" /><TextBlock Text="ДИАГНОСТИКА" Style="{StaticResource PaneHeader}" /><TextBlock Text="Настройки хранятся локально и не отправляются на внешние серверы. Для чтения истории используется установленный Git." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border></Grid>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#E4EAF1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="11,0"><TextBlock x:Name="StatusText" Text="Готово" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" /><ProgressBar x:Name="BusyProgress" Width="130" Height="3" HorizontalAlignment="Right" VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" /></Grid></Border>
    </Grid>
</Window>
