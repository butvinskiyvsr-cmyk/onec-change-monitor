<Window x:Class="OneCChangeMonitor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Контур изменений 1С"
        Width="1280" Height="820" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F3F6F9"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2474D2" />
        <SolidColorBrush x:Key="TextBrush" Color="#18212B" />
        <SolidColorBrush x:Key="MutedBrush" Color="#657284" />
        <SolidColorBrush x:Key="LineBrush" Color="#DCE3EA" />
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" /><Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Height" Value="42" /><Setter Property="Margin" Value="0,2" /><Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Foreground" Value="#DCE6EF" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="225" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#172433">
            <Grid Margin="14,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,22">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="1С" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Контур&#x0a;изменений" Margin="10,0,0,0" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource SidebarButton}" Background="#304052" FontWeight="SemiBold" Content="Лента изменений" />
                    <Button Style="{StaticResource SidebarButton}" IsEnabled="False" Content="Объекты 1С                 скоро" />
                    <Button Style="{StaticResource SidebarButton}" IsEnabled="False" Content="Сравнение                 скоро" />
                    <Button Style="{StaticResource SidebarButton}" IsEnabled="False" Content="Релизы                        скоро" />
                    <Button Style="{StaticResource SidebarButton}" IsEnabled="False" Content="Качество                    скоро" />
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="10">
                    <TextBlock Text="Версия 0.1.0" Foreground="#AAB8C7" FontSize="12" />
                    <TextBlock Text="Windows Desktop" Foreground="#7F91A5" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProjectCombo" Grid.Column="0" DisplayMemberPath="Name" SelectionChanged="ProjectCombo_SelectionChanged" VerticalAlignment="Center" />
                    <ComboBox x:Name="BranchCombo" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="BranchCombo_SelectionChanged" VerticalAlignment="Center" />
                    <TextBlock x:Name="SyncLabel" Grid.Column="3" Text="Локальная копия" Foreground="#19744A" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <Button x:Name="SyncButton" Grid.Column="4" Style="{StaticResource ToolbarButton}" Content="Синхронизировать" Click="SyncButton_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,22,22,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Изменения конфигурации" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Коммиты Git, переведённые на язык объектов 1С" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" ToolTip="Поиск по названию, автору или хэшу" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="Последние коммиты" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center" />
                            </Border>
                            <ListBox x:Name="CommitList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="CommitList_SelectionChanged" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="14,12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="BorderBrush" Value="#E5EAF0" /><Setter Property="BorderThickness" Value="0,0,0,1" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding ShortSha}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="12" Margin="8,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DetailsPanel" Margin="20">
                                <TextBlock x:Name="EmptyDetails" Text="Выберите коммит слева" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,50" />
                                <StackPanel x:Name="CommitDetails" Visibility="Collapsed">
                                    <TextBlock x:Name="CommitTitle" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CommitMeta" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                    <Border x:Name="WarningPanel" Visibility="Collapsed" Margin="0,14,0,0" Padding="12" CornerRadius="7" Background="#FFF2D4">
                                        <TextBlock x:Name="WarningText" Foreground="#855100" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="ИЗМЕНЁННЫЕ ФАЙЛЫ И ОБЪЕКТЫ" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,20,0,8" />
                                    <ListBox x:Name="FileList" MaxHeight="250" BorderThickness="0" SelectionChanged="FileList_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="BorderBrush" Value="#E5EAF0" /><Setter Property="BorderThickness" Value="0,0,0,1" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Background="#EEF2F6" CornerRadius="10" Height="24" Width="36" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="DiffPath" Margin="0,18,0,0" Padding="10" Background="#EEF2F6" Foreground="#526173" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                    <RichTextBox x:Name="DiffBox" IsReadOnly="True" BorderThickness="0" Background="#151B23" Foreground="#E9EEF5" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Padding="8" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#E9EEF3">
                <TextBlock x:Name="StatusText" Text="Готово" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,0" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Window>
