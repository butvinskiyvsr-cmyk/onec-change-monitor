<Window x:Class="OneCChangeMonitor.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение конфигурации 1С" Width="690" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="118" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"><TextBlock Text="1C" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Подключите конфигурацию" Foreground="White" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Локальный Git-репозиторий с выгрузкой XML/BSL" Foreground="#9DB1C9" Margin="0,5,0,0" /></StackPanel></Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="24" Padding="24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Название проекта" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" /><TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Text="Project_upr" /></Grid>
                <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions><TextBlock Text="Папка Git" VerticalAlignment="Center" /><TextBox x:Name="PathBox" Grid.Column="1" Style="{StaticResource InputTextBox}" /><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="Обзор…" Click="BrowseButton_Click" /></Grid>
                <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Адрес Git" /><TextBlock Text="необязательно" Foreground="{StaticResource MutedBrush}" FontSize="10" /></StackPanel><TextBox x:Name="RemoteBox" Grid.Column="1" Style="{StaticResource InputTextBox}" ToolTip="Можно оставить пустым для локальной работы" /></Grid>
                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Основная ветка" VerticalAlignment="Center" /><TextBox x:Name="BranchBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Text="master" /></Grid>
                <TextBlock x:Name="ValidationText" Grid.Row="4" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="145,12,0,0" />
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="100" Style="{StaticResource SecondaryButton}" Content="Отмена" IsCancel="True" /><Button Width="132" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0" Content="Подключить" Click="SaveButton_Click" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
