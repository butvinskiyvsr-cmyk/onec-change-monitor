<Window x:Class="OneCChangeMonitor.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConfigScope — подключение проекта" Width="720" Height="590" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"><TextBlock Text="CS" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Подключение проекта" Foreground="White" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="ConfigScope настроит источник Git и структуру выгрузки 1С" Foreground="#A4B8CF" Margin="0,5,0,0" /></StackPanel></Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="24" Padding="24,20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="42" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="42" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentBrush}"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border><TextBlock Text="Репозиторий" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0" /></StackPanel>
                    <Border Grid.Column="1" Height="1" Background="{StaticResource BorderBrush}" Margin="8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource SurfaceAltBrush}"><TextBlock Text="2" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border><TextBlock Text="Структура 1С" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="7,0,0,0" /></StackPanel>
                    <Border Grid.Column="3" Height="1" Background="{StaticResource BorderBrush}" Margin="8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource SurfaceAltBrush}"><TextBlock Text="3" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border><TextBlock Text="Проверка" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="7,0,0,0" /></StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="158" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Название" /><TextBlock Text="Будет видно в боковой панели" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel><TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Text="Project_upr" /></Grid>
                <Grid Grid.Row="2" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="158" /><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Папка репозитория" /><TextBlock Text="Каталог должен содержать .git" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel><TextBox x:Name="PathBox" Grid.Column="1" Style="{StaticResource InputTextBox}" /><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="Выбрать…" Click="BrowseButton_Click" /></Grid>
                <Grid Grid.Row="3" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="158" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Адрес Git" /><TextBlock Text="Можно оставить пустым" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel><TextBox x:Name="RemoteBox" Grid.Column="1" Style="{StaticResource InputTextBox}" ToolTip="Например, адрес Gitea или GitHub" /></Grid>
                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="158" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Основная ветка" /><TextBlock Text="Можно изменить позднее" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel><TextBox x:Name="BranchBox" Grid.Column="1" Style="{StaticResource InputTextBox}" Text="master" /></Grid>

                <StackPanel Grid.Row="5" Margin="158,14,0,0">
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="10"><TextBlock Text="После подключения ConfigScope найдёт каталоги конфигурации, проверит Git и покажет, какие BSL/XML-файлы будут анализироваться." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" /></Border>
                    <TextBlock x:Name="ValidationText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,9,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="100" Style="{StaticResource SecondaryButton}" Content="Отмена" IsCancel="True" /><Button Width="140" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0" Content="Подключить" Click="SaveButton_Click" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
