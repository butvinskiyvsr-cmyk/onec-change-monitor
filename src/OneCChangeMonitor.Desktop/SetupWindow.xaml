<Window x:Class="OneCChangeMonitor.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подключение конфигурации 1С"
        Width="620" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6F9"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Подключите репозиторий 1С" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Настройки сохраняются только на этом компьютере." Foreground="#657284" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Название" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" Height="36" Padding="9,6" Text="Project_upr" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
            <TextBlock Text="Папка репозитория" VerticalAlignment="Center" />
            <TextBox x:Name="PathBox" Grid.Column="1" Height="36" Padding="9,6" />
            <Button Grid.Column="2" Height="36" Margin="8,0,0,0" Content="Обзор…" Click="BrowseButton_Click" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Адрес Git" VerticalAlignment="Center" />
            <TextBox x:Name="RemoteBox" Grid.Column="1" Height="36" Padding="9,6" ToolTip="Можно оставить пустым для локальной работы" />
        </Grid>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Основная ветка" VerticalAlignment="Center" />
            <TextBox x:Name="BranchBox" Grid.Column="1" Height="36" Padding="9,6" Text="master" />
        </Grid>

        <TextBlock x:Name="ValidationText" Grid.Row="6" Foreground="#A52323" TextWrapping="Wrap" Margin="145,12,0,0" />
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" Height="38" Content="Отмена" IsCancel="True" />
            <Button Width="130" Height="38" Margin="10,0,0,0" Background="#2474D2" Foreground="White" Content="Подключить" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
